# =============================================================================
# TechFOREST - Variables d'environnement pour docker-compose
# Copier en `.env` a la racine puis completer. Ne jamais committer ce .env.
#
#   cp .env.example .env
#   docker compose up --build
# =============================================================================

# --- PostgreSQL (service db) -------------------------------------------------
DB_USER=techforest
DB_NAME=techforest_db
# OBLIGATOIRE. Choisir un mot de passe fort.
DB_PASSWORD=change_me_strong_password

# --- API FastAPI (service app) -----------------------------------------------
# Port expose sur l'hote (le conteneur ecoute toujours sur 8000 en interne).
APP_PORT=8000

# OBLIGATOIRE. Generer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Origines CORS autorisees (separees par virgules)
CORS_ORIGINS=http://localhost:8000,http://localhost:5173

DEBUG=false

# --- Compte super-admin bootstrap (OPTIONNEL) --------------------------------
# Si ces deux variables sont remplies, un compte superadmin est cree au
# premier demarrage (idempotent). Changer le mot de passe via l'API ensuite.
DEFAULT_SUPERADMIN_EMAIL=
DEFAULT_SUPERADMIN_PASSWORD=

# --- Reste de la configuration (KOBO, GEE, ...) ------------------------------
# Place les variables additionnelles dans Backend/.env (charge automatiquement
# par le conteneur si le fichier existe). Voir Backend/.env.example.
