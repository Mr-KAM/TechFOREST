# =============================================================================
# TechFOREST - Variables d'environnement pour docker-compose (PRODUCTION)
# Copier en `.env` a la racine puis completer. Ne jamais committer ce .env.
#
#   cp .env.example .env
#   docker compose up --build -d
# =============================================================================

# --- PostgreSQL (service db) -------------------------------------------------
DB_USER=techforest
DB_NAME=techforest_db
# OBLIGATOIRE. Choisir un mot de passe fort (min 20 caracteres).
DB_PASSWORD=change_me_strong_password

# --- API FastAPI (service app) -----------------------------------------------
# Port expose sur l'hote (le conteneur ecoute toujours sur 8000 en interne).
APP_PORT=8000

# OBLIGATOIRE. Generer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Origines CORS : en production, ne mettre que le(s) domaine(s) reels.
# Ex: CORS_ORIGINS=https://techforest.example.com
CORS_ORIGINS=http://localhost:8000

# Nombre de workers uvicorn. Regle : 2 * nb_vCPU + 1.
# Ex: VPS 2 vCPU -> UVICORN_WORKERS=5
UVICORN_WORKERS=2

# --- Compte super-admin bootstrap (OPTIONNEL) --------------------------------
# Si ces deux variables sont remplies, un compte superadmin est cree au
# premier demarrage (idempotent). Changer le mot de passe via l'API ensuite.
DEFAULT_SUPERADMIN_EMAIL=
DEFAULT_SUPERADMIN_PASSWORD=

# --- Google Earth Engine (OPTIONNEL) -----------------------------------------
# Si GEE n'est pas utilise, creer un fichier vide pour eviter l'erreur de
# montage Docker :
#   echo '{}' > Backend/service-account-key-gee-true.json
# Pour la production sur un serveur distant, privilegier un secret manager
# ou l'inject de fichier Dokploy / vault.

# --- Reste de la configuration (KOBO, GEE tokens, ...) ----------------------
# Placer les variables additionnelles dans Backend/.env (charge automatiquement
# par le conteneur si le fichier existe). Voir Backend/.env.example.
