# ======================
# Configuration Backend TechFOREST
# ======================

# Base de données (PostgreSQL + PostGIS)
# En local (Docker Compose) : postgresql://techforest:techforest@db:5432/techforest_db
# En local hors Docker : postgresql://techforest:techforest@localhost:5432/techforest_db
# En production (ex. Supabase pooler) : postgresql://USER:PASSWORD@HOST:6543/postgres
DATABASE_URL=postgresql://techforest:techforest@db:5432/techforest_db

# Connexion directe à la base (utilisée pour les migrations Alembic)
# Optionnelle en local — requise si DATABASE_URL pointe vers un pooler (ex. Supabase port 6543)
DIRECT_URL=postgresql://techforest:techforest@db:5432/techforest_db


# Authentification JWT
SECRET_KEY=change-me-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google Earth Engine (Compte de service)
GEE_CREDENTIALS_FILE=service-account-key-gee-true.json
GEE_PROJECT_ID=your-gee-project-id

# Données GeoJSON
DATA_DIR=data

# KoboToolbox
URL_KOBO=https://kf.kobotoolbox.org/
KOBO_API_TOKEN=your-kobotoolbox-api-token
API_VERSION=2

# UID des différents formulaires KoboToolbox des activités
UID_MONITORING_FAUNE=your-kobo-form-uid
UID_MONITORING_REBOISEMENT=your-kobo-form-uid
UID_PLANTING_ARBRE=your-kobo-form-uid
UID_MENACES=your-kobo-form-uid

# Origines CORS autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Application
APP_NAME=TechFOREST API
DEBUG=true

# ======================
# Comptes par défaut créés au premier démarrage
# (script `python -m app.scripts.load_geodata`)
# ⚠️  Changez ces mots de passe en production !
# ======================

# Superadministrateur (accès total + gestion des admins)
DEFAULT_SUPERADMIN_EMAIL=superadmin@techforest.com
DEFAULT_SUPERADMIN_PASSWORD=superadmin123
DEFAULT_SUPERADMIN_FULLNAME=Super Administrateur TechFOREST

# Administrateur principal
DEFAULT_ADMIN_EMAIL=techforestadmin@gmail.com
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_FULLNAME=Administrateur TechFOREST

# Utilisateur classique du compte principal (lecture seule par défaut)
DEFAULT_USER_EMAIL=user@techforest.com
DEFAULT_USER_PASSWORD=user123
DEFAULT_USER_FULLNAME=Utilisateur TechFOREST
# Rôles autorisés : viewer | editor | admin | superadmin
DEFAULT_USER_ROLE=viewer

