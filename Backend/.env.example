# ======================
# Configuration Backend TechFOREST
# Copier en `Backend/.env` puis remplir. Ne jamais committer ce .env.
# ======================

# --- Base de donnees (PostgreSQL + PostGIS) ---
# Docker Compose local : postgresql://techforest:${DB_PASSWORD}@db:5432/techforest_db
# Local sans Docker    : postgresql://techforest:pass@localhost:5432/techforest_db
# Supabase (pooler)    : postgresql://USER:PASSWORD@HOST:6543/postgres
DATABASE_URL=

# Connexion directe (utilisee par Alembic). Optionnelle en local;
# requise si DATABASE_URL passe par un pooler (ex. Supabase port 6543).
DIRECT_URL=

# Pool de connexions SQLAlchemy.
# Mettre DB_USE_NULL_POOL=true si DATABASE_URL pointe vers un pooler externe
# (Supabase pgBouncer port 6543, PgBouncer, RDS Proxy...) pour eviter le
# double-pooling qui epuise les slots.
# En Docker Compose ou connexion directe, laisser false (pool interne actif).
DB_USE_NULL_POOL=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# --- Authentification JWT (REQUIS) ---
# Generer une cle robuste :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Google Earth Engine ---
# Le fichier JSON du compte de service n'est JAMAIS commit. Il est monte
# en volume au runtime (docker-compose) ou injecte via secret manager.
GEE_CREDENTIALS_FILE=service-account-key-gee-true.json
GEE_PROJECT_ID=

# --- Donnees GeoJSON ---
DATA_DIR=data

# --- KoboToolbox ---
URL_KOBO=https://kf.kobotoolbox.org/
KOBO_API_TOKEN=
API_VERSION=2
UID_MONITORING_FAUNE=
UID_MONITORING_REBOISEMENT=
UID_PLANTING_ARBRE=
UID_MENACES=

# --- CORS (origines autorisees, separees par virgules) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Application ---
APP_NAME=TechFOREST API
# DEBUG=true uniquement en local. Laisser false en production.
DEBUG=false

# ======================
# Comptes bootstrap (OPTIONNELS)
# Le script `python -m app.scripts.load_geodata` ne cree un compte
# QUE si l'email ET le mot de passe correspondants sont definis ici.
# A utiliser uniquement pour amorcer l'environnement, puis changer
# immediatement les mots de passe via l'API.
# ======================

DEFAULT_SUPERADMIN_EMAIL=
DEFAULT_SUPERADMIN_PASSWORD=
DEFAULT_SUPERADMIN_FULLNAME=Super Administrateur TechFOREST

DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_FULLNAME=Administrateur TechFOREST

DEFAULT_USER_EMAIL=
DEFAULT_USER_PASSWORD=
DEFAULT_USER_FULLNAME=Utilisateur TechFOREST
# Roles autorises : viewer | editor | admin | superadmin
DEFAULT_USER_ROLE=viewer
