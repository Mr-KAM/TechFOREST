# ======================
# TechFOREST Backend Config
# ======================

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://user:password@localhost:5432/techforest_db

# JWT Authentication
SECRET_KEY=change-me-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google Earth Engine (OAuth2 credentials)
GEE_CREDENTIALS_FILE=gee-service-account-key.json
GEE_PROJECT_ID=your-gee-project-id

# Données GeoJSON
DATA_DIR=data

# KoboToolbox
KOBO_API_URL=https://kf.kobotoolbox.org/api/v2
KOBO_API_TOKEN=your-kobotoolbox-api-token

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# App
APP_NAME=TechFOREST API
DEBUG=true
